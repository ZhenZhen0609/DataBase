  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #1e1e2e;
}

QLabel {
    color: #cdd6f4;
    font-size: 14px;
}

QLineEdit, QTextEdit {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 8px;
    color: #cdd6f4;
    font-family: Consolas, monospace;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #89b4fa;
}

QPushButton {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 8px 16px;
    color: #cdd6f4;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #45475a;
}

QPushButton:pressed {
    background-color: #585b70;
}

QPushButton#btnLogin {
    background-color: #89b4fa;
    color: #1e1e2e;
    font-weight: bold;
}

QPushButton#btnLogin:hover {
    background-color: #b4befe;
}

QPushButton#btnCreateDb, QPushButton#btnCreateTable, QPushButton#btnAddField, QPushButton#btnInsertRecord {
    background-color: #a6e3a1;
    color: #1e1e2e;
}

QPushButton#btnCreateDb:hover, QPushButton#btnCreateTable:hover, QPushButton#btnAddField:hover, QPushButton#btnInsertRecord:hover {
    background-color: #baf0b8;
}

QPushButton#btnDropDb, QPushButton#btnDropTable, QPushButton#btnDropField {
    background-color: #f38ba8;
    color: #1e1e2e;
}

QPushButton#btnDropDb:hover, QPushButton#btnDropTable:hover, QPushButton#btnDropField:hover {
    background-color: #eba0ac;
}

QPushButton#btnExecuteSQL {
    background-color: #89b4fa;
    color: #1e1e2e;
    font-weight: bold;
}

QPushButton#btnExecuteSQL:hover {
    background-color: #b4befe;
}

QTreeWidget {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 8px;
    color: #cdd6f4;
    show-decoration-selected: 1;
}

QTreeWidget::item {
    padding: 6px;
}

QTreeWidget::item:hover {
    background-color: #45475a;
}

QTreeWidget::item:selected {
    background-color: #89b4fa;
    color: #1e1e2e;
}

QTableWidget {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    color: #cdd6f4;
    gridline-color: #45475a;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #89b4fa;
    color: #1e1e2e;
}

QHeaderView::section {
    background-color: #45475a;
    color: #cdd6f4;
    padding: 8px;
    border: none;
    font-weight: bold;
}

QTabWidget::pane {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #313244;
    color: #cdd6f4;
    padding: 10px 20px;
    border: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #45475a;
}

QTabBar::tab:selected {
    background-color: #313244;
    color: #89b4fa;
}

QTabBar::tab:!selected {
    margin-bottom: 0px;
}

QMenuBar {
    background-color: #181825;
    color: #cdd6f4;
}

QMenuBar::item {
    background-color: #181825;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #45475a;
}

QMenu {
    background-color: #313244;
    color: #cdd6f4;
}

QMenu::item {
    padding: 8px 16px;
}

QMenu::item:selected {
    background-color: #45475a;
}

QStatusBar {
    background-color: #181825;
    color: #a6adc8;
}

QTextEdit#logOutput {
    background-color: #11111b;
    border: 1px solid #45475a;
    border-radius: 6px;
    color: #a6e3a1;
    font-family: Consolas, monospace;
}

QScrollBar:vertical {
    background: #313244;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}</string>
